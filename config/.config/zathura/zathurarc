set selection-clipboard clipboard

# Everforest Dark Hard theme
set default-bg "#272e33"
set default-fg "#d3c6aa"

set statusbar-bg "#2e383c"
set statusbar-fg "#d3c6aa"

set inputbar-bg "#272e33"
set inputbar-fg "#d3c6aa"

set notification-bg "#272e33"
set notification-fg "#d3c6aa"
set notification-error-bg "#e67e80"
set notification-error-fg "#272e33"
set notification-warning-bg "#dbbc7f"
set notification-warning-fg "#272e33"

set highlight-color "#a7c080"
set highlight-active-color "#7fbbb3"

set completion-bg "#2e383c"
set completion-fg "#d3c6aa"
set completion-highlight-bg "#7fbbb3"
set completion-highlight-fg "#272e33"

set recolor-lightcolor "#272e33"
set recolor-darkcolor "#d3c6aa"
set recolor false

# Padding and appearance
set statusbar-h-padding 10
set statusbar-v-padding 10
