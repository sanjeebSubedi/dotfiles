# Appearance
font=SF Pro Text 11
background-color=#2D353BCC
text-color=#D3C6AA
border-color=#A7C080
border-size=1
border-radius=8
padding=12
margin=10

# Position & Layout
anchor=top-right
width=300
max-visible=5
layer=overlay

# Behavior
default-timeout=5000
max-history=50

# Icons
icons=1
max-icon-size=48

# Urgency styles
[urgency=low]
background-color=#3A454ACC
border-color=#859289

[urgency=normal]
background-color=#2D353BCC
border-color=#A7C080

[urgency=critical]
background-color=#2D353BEE
border-color=#E67E80
default-timeout=0
