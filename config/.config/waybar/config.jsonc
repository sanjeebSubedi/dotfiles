{
  "layer": "top",
  "position": "top",
  "height": 28,
  "exclusive": true,
  "spacing": 0,
  "modules-left": ["custom/arch", "hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": [
    "custom/recording",
    "group/controls-expander",
    "bluetooth#connected",
    "idle_inhibitor#outside",
    "network",
    "pulseaudio",
    "battery",
    "custom/power-menu",
  ],
  "group/controls-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 500,
      "children-class": "tray-group-item",
    },
    "modules": [
      "group/expand-icons",
      "tray",
      "idle_inhibitor#tray",
      "bluetooth#tray",
      "backlight",
    ],
  },
  "group/expand-icons": {
    "orientation": "inherit",
    "modules": ["custom/expand-icon#horizontal"],
  },
  "custom/expand-icon#horizontal": {
    "format": "",
    "tooltip": false,
    "on-scroll-up": "",
    "on-scroll-down": "",
    "on-scroll-left": "",
    "on-scroll-right": "",
  },
  "idle_inhibitor#tray": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": "󰛊",
    },
    "tooltip-format-activated": "Idle inhibitor: ON\nScreen will not sleep",
    "tooltip-format-deactivated": "Idle inhibitor: OFF\nNormal sleep behavior",
  },
  "idle_inhibitor#outside": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "",
    },
    "tooltip-format-activated": "Idle inhibitor: ON\nScreen will not sleep",
    "tooltip-format-deactivated": "Idle inhibitor: OFF\nNormal sleep behavior",
  },
  "bluetooth#tray": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-connected": "",
    "format-connected-battery": "",
    "tooltip-format": "{controller_alias}\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-enumerate-connected-battery": "{device_alias} ({device_battery_percentage}%)",
    "on-click": "hyprctl dispatch 'hl.dsp.exec_cmd(\"~/.config/hypr/scripts/bluetui.sh\")'",
  },
  "bluetooth#connected": {
    "format": "",
    "format-disabled": "",
    "format-off": "",
    "format-on": "",
    "format-no-controller": "",
    "format-connected": "󰂱 {num_connections}",
    "format-connected-battery": "󰂱 {device_battery_percentage}%",
    "tooltip-format-connected": "{controller_alias}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-enumerate-connected-battery": "{device_alias} ({device_battery_percentage}%)",
    "on-click": "hyprctl dispatch 'hl.dsp.exec_cmd(\"~/.config/hypr/scripts/bluetui.sh\")'",
  },
  "network": {
    "interval": 3,
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format-wifi": "{icon}",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤭",
    "tooltip-format-wifi": "󰤨  {essid}\n󰩟  {ipaddr}\n󰇚  {bandwidthDownBytes}\n󰕒  {bandwidthUpBytes}",
    "tooltip-format-ethernet": "󰈀  {ifname}\n󰩟  {ipaddr}\n󰇚  {bandwidthDownBytes}\n󰕒  {bandwidthUpBytes}",
    "tooltip-format-disconnected": "󰤭  Disconnected",
    "on-click": "hyprctl dispatch 'hl.dsp.exec_cmd(\"kitty --class impala-float -e impala\")'",
  },
  "custom/arch": {
    "format": "󰣇",
    "tooltip-format": "Arch Linux",
  },
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{name}",
  },
  "clock": {
    "format": "{:%a %H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt>{calendar}</tt>",
    "on-click": "hyprctl dispatch 'hl.dsp.exec_cmd(\"kitty --class calcurse-float -e calcurse\")'",
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "format": "{icon}",
    "format-charging": "󰂄",
    "format-plugged": "",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{capacity}% • {timeTo}",
    "tooltip-format-charging": "{capacity}% • Charging ({timeTo})",
    "tooltip-format-plugged": "{capacity}% • Plugged in",
    "tooltip-format-full": "Full",
    "on-click": "hyprctl dispatch 'hl.dsp.exec_cmd(\"~/.config/hypr/scripts/power-profile.sh\")'",
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "default": ["", "", ""],
    },
    "tooltip-format": "{volume}%",
    "on-click": "hyprctl dispatch 'hl.dsp.exec_cmd(\"kitty --class wiremix-float -e wiremix\")'",
  },
  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
  },
  "tray": {
    "icon-size": 14,
    "spacing": 12,
    "reverse-direction": true,
  },
  "custom/power-menu": {
    "format": "",
    "tooltip-format": "Power Menu",
    "on-click": "hyprctl dispatch 'hl.dsp.exec_cmd(\"~/.config/hypr/scripts/wlogout.sh\")'",
  },
  "custom/recording": {
    "exec": "~/.config/hypr/scripts/screen-record.sh status",
    "return-type": "json",
    "format": "{}",
    "interval": "once",
    "signal": 8,
    "on-click": "hyprctl dispatch 'hl.dsp.exec_cmd(\"~/.config/hypr/scripts/screen-record.sh screen\")'",
  },
}
