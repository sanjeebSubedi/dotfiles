#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
// Everforest Dark Hard theme for rmpc. Mirrors the default theme's layout and
// components (run `rmpc theme` to print the default) with the colour scheme
// remapped to Everforest. Green (#A7C080) is the primary accent to match the
// rest of the desktop (hyprlock, waybar, starship).
//
// Palette:
//   bg #2D353B  bg2 #3D484D  fg #D3C6AA  grey #859289
//   red #E67E80  orange #E69875  yellow #DBBC7F
//   green #A7C080  aqua #83C092  blue #7FBBB3  purple #D699B6
(
    default_album_art_path: None,
    format_tag_separator: " | ",
    browser_column_widths: [20, 38, 42],
    // Leave the background unset so the terminal's (Everforest) background and
    // any transparency show through.
    background_color: None,
    text_color: "#D3C6AA",
    header_background_color: None,
    modal_background_color: "#2D353B",
    modal_backdrop: true,
    preview_label_style: (fg: "#83C092"),
    preview_metadata_group_style: (fg: "#83C092", modifiers: "Bold"),
    highlighted_item_style: (fg: "#A7C080", modifiers: "Bold"),
    current_item_style: (fg: "#2D353B", bg: "#A7C080", modifiers: "Bold"),
    borders_style: (fg: "#859289"),
    highlight_border_style: (fg: "#A7C080"),
    symbols: (
        song: "",
        dir: "",
        playlist: "",
        marker: "",
        ellipsis: "…",
        song_style: (fg: "#D3C6AA"),
        dir_style: (fg: "#7FBBB3"),
        playlist_style: (fg: "#DBBC7F"),
    ),
    level_styles: (
        info: (fg: "#A7C080", bg: "#2D353B"),
        warn: (fg: "#DBBC7F", bg: "#2D353B"),
        error: (fg: "#E67E80", bg: "#2D353B"),
        debug: (fg: "#83C092", bg: "#2D353B"),
        trace: (fg: "#D699B6", bg: "#2D353B"),
    ),
    progress_bar: (
        symbols: ["█", "█", "█", " ", "█"],
        track_style: (fg: "#3D484D"),
        elapsed_style: (fg: "#A7C080"),
        thumb_style: (fg: "#A7C080"),
        use_track_when_empty: true,
    ),
    scrollbar: (
        symbols: ["│", "█", "▲", "▼"],
        track_style: (fg: "#3D484D"),
        ends_style: (fg: "#3D484D"),
        thumb_style: (fg: "#A7C080"),
    ),
    tab_bar: (
        active_style: (fg: "#2D353B", bg: "#A7C080", modifiers: "Bold"),
        inactive_style: (fg: "#859289"),
    ),
    lyrics: (
        timestamp: false
    ),
    browser_song_format: [
        (
            kind: Group([
                (kind: Property(Track)),
                (kind: Text(" ")),
            ])
        ),
        (
            kind: Group([
                (kind: Property(Artist)),
                (kind: Text(" - ")),
                (kind: Property(Title)),
            ]),
            default: (kind: Property(Filename))
        ),
    ],
    song_table_format: [
        (
            prop: (kind: Property(Artist),
                default: (kind: Text("Unknown"))
            ),
            label_prop: (kind: Text("Artist")),
            width: "20%",
        ),
        (
            prop: (kind: Property(Title),
                default: (kind: Text("Unknown"))
            ),
            label_prop: (kind: Text("Title")),
            width: "35%",
        ),
        (
            prop: (kind: Property(Album), style: (fg: "#859289"),
                default: (kind: Text("Unknown Album"), style: (fg: "#859289"))
            ),
            label_prop: (kind: Text("Album")),
            width: "30%",
        ),
        (
            prop: (kind: Property(Duration),
                default: (kind: Text("-"))
            ),
            label_prop: (kind: Text("Duration")),
            width: "15%",
            alignment: Right,
        ),
    ],
    layout: Split(
        direction: Vertical,
        panes: [
            (
                size: "4",
                pane: Split(
                    direction: Horizontal,
                    panes: [
                        (
                            size: "35",
                            borders: "LEFT | TOP | BOTTOM",
                            border_symbols: Inherited(parent: Rounded, bottom_left: "├"),
                            pane: Component("header_left")
                        ),
                        (
                            size: "100%",
                            borders: "ALL",
                            border_symbols: Inherited(parent: Rounded, top_left: "┬", top_right: "┬", bottom_left: "┴", bottom_right: "┴"),
                            pane: Component("header_center")
                        ),
                        (
                            size: "35",
                            borders: "RIGHT | TOP | BOTTOM",
                            border_symbols: Inherited(parent: Rounded, bottom_right: "┤"),
                            pane: Component("header_right")
                        ),
                    ]
                )
            ),
            (
                pane: Pane(Tabs),
                borders: "RIGHT | LEFT | BOTTOM",
                border_symbols: Rounded,
                size: "2",
            ),
            (
                pane: Pane(TabContent),
                size: "100%",
            ),
            (
                size: "3",
                pane: Split(
                    direction: Horizontal,
                    panes: [
                        (
                            size: "12",
                            borders: "ALL",
                            border_symbols: Inherited(parent: Rounded, top_right: "┬", bottom_right: "┴"),
                            pane: Component("input_mode")
                        ),
                        (
                            size: "100%",
                            borders: "TOP | BOTTOM | RIGHT",
                            border_symbols: Rounded,
                            border_title: [(kind: Text(" ")), (kind: Property(Status(QueueLength()))), (kind: Text(" songs / ")), (kind: Property(Status(QueueTimeTotal()))), (kind: Text(" total time "))],
                            border_title_alignment: Right,
                            pane: Component("progress_bar"),
                        ),
                    ]
                ),
            ),
        ],
    ),
    components: {
        "state": Pane(Property(
            content: [
                (kind: Text("["), style: (fg: "#DBBC7F", modifiers: "Bold")),
                (kind: Property(Status(StateV2( ))), style: (fg: "#DBBC7F", modifiers: "Bold")),
                (kind: Text("]"), style: (fg: "#DBBC7F", modifiers: "Bold")),
            ], align: Left,
        )),
        "title": Pane(Property(
            content: [
                (kind: Property(Song(Title)), style: (fg: "#D3C6AA", modifiers: "Bold"),
                    default: (kind: Text("No Song"), style: (fg: "#D3C6AA", modifiers: "Bold"))),
            ], align: Center, scroll_speed: 1
        )),
        "volume": Split(
            direction: Horizontal,
            panes: [
                (size: "1", pane: Pane(Property(content: [(kind: Text(""))]))),
                (size: "100%", pane: Pane(Volume(kind: Slider(symbols: (filled: "─", thumb: "●", track: "─"))))),
                (size: "3", pane: Pane(Property(content: [(kind: Property(Status(Volume)), style: (fg: "#A7C080"))], align: Right))),
                (size: "2", pane: Pane(Property(content: [(kind: Text("%"), style: (fg: "#A7C080"))]))),
            ]
        ),
        "elapsed_and_bitrate": Pane(Property(
            content: [
                (kind: Property(Status(Elapsed))),
                (kind: Text(" / ")),
                (kind: Property(Status(Duration))),
                (kind: Group([
                    (kind: Text(" (")),
                    (kind: Property(Status(Bitrate))),
                    (kind: Text(" kbps)")),
                ])),
            ],
            align: Left,
        )),
        "artist_and_album": Pane(Property(
            content: [
                (kind: Property(Song(Artist)), style: (fg: "#DBBC7F", modifiers: "Bold"),
                    default: (kind: Text("Unknown"), style: (fg: "#DBBC7F", modifiers: "Bold"))),
                (kind: Text(" - ")),
                (kind: Property(Song(Album)), default: (kind: Text("Unknown Album"))),
            ], align: Center, scroll_speed: 1
        )),
        "states": Split(
            direction: Horizontal,
            panes: [
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
                (
                    size: "100%",
                    pane: Pane(Property(content: [(kind: Property(Status(InputBuffer())), style: (fg: "#A7C080"), align: Left)]))
                ),
                (
                    size: "6",
                    pane: Pane(Property(content: [
                        (kind: Text("["), style: (fg: "#A7C080", modifiers: "Bold")),
                        (kind: Property(Status(RepeatV2(
                            on_label: "z",
                            off_label: "z",
                            on_style: (fg: "#DBBC7F", modifiers: "Bold"),
                            off_style: (fg: "#859289", modifiers: "Dim"),
                        )))),
                        (kind: Property(Status(RandomV2(
                            on_label: "x",
                            off_label: "x",
                            on_style: (fg: "#DBBC7F", modifiers: "Bold"),
                            off_style: (fg: "#859289", modifiers: "Dim"),
                        )))),
                        (kind: Property(Status(ConsumeV2(
                            on_label: "c",
                            off_label: "c",
                            oneshot_label: "c",
                            on_style: (fg: "#DBBC7F", modifiers: "Bold"),
                            off_style: (fg: "#859289", modifiers: "Dim"),
                            oneshot_style: (fg: "#E67E80", modifiers: "Dim"),
                        )))),
                        (kind: Property(Status(SingleV2(
                            on_label: "v",
                            off_label: "v",
                            oneshot_label: "v",
                            on_style: (fg: "#DBBC7F", modifiers: "Bold"),
                            off_style: (fg: "#859289", modifiers: "Dim"),
                            oneshot_style: (fg: "#E67E80", modifiers: "Bold"),
                        )))),
                        (kind: Text("]"), style: (fg: "#A7C080", modifiers: "Bold")),
                        ],
                        align: Right
                    ))
                ),
            ]
        ),
        "input_mode": Pane(Property(
            content: [
                (kind: Transform(Replace(content: (kind: Property(Status(InputMode()))), replacements: [
                    (match: "Normal", replace: (kind: Text(" NORMAL "), style: (fg: "#2D353B", bg: "#7FBBB3"))),
                    (match: "Insert", replace: (kind: Text(" INSERT "), style: (fg: "#2D353B", bg: "#A7C080"))),
                ])))
            ], align: Center
        )),
        "header_left": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("state")),
                (size: "1", pane: Component("elapsed_and_bitrate")),
            ]
        ),
        "header_center": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("title")),
                (size: "1", pane: Component("artist_and_album")),
            ]
        ),
        "header_right": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("volume")),
                (size: "1", pane: Component("states")),
            ]
        ),
        "progress_bar": Split(
            direction: Horizontal,
            panes: [
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
                (
                    size: "100%",
                    pane: Pane(ProgressBar)
                ),
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
            ]
        )
    },
)
